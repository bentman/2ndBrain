#!/bin/sh
# Keeps private notes out of the public 2ndBrain repository.
# Enable once per clone, from the repository root:
#   git config core.hooksPath _system/hooks
# Blocked: anything under _user/ except README.md and empty .gitkeep files in
# the work/life skeleton, and any top-level work/ or life/ folder.
# -z keeps Git from quoting unusual file names, which would hide them from grep.

staged=$(git diff --cached --name-only -z --diff-filter=ACMRT | tr '\0' '\n' |
    grep -i -E '^(_user|work|life)/')
[ -z "$staged" ] && exit 0

bad=$(printf '%s\n' "$staged" |
    grep -v -E '^_user/(README\.md|(work|life)/[^/]+/\.gitkeep)$')

keeps=$(printf '%s\n' "$staged" |
    grep -E '^_user/(work|life)/[^/]+/\.gitkeep$')
if [ -n "$keeps" ]; then
    while IFS= read -r f; do
        [ "$(git cat-file -s ":$f" 2>/dev/null)" = "0" ] || bad="$bad
$f (.gitkeep must be empty)"
    done <<EOF
$keeps
EOF
fi

bad=$(printf '%s\n' "$bad" | sed '/^$/d')
if [ -n "$bad" ]; then
    echo "Commit blocked: private content is staged in the public repository:"
    printf '%s\n' "$bad" | sed 's/^/  /'
    echo "Unstage with: git restore --staged <path>"
    echo "Private notes belong under _user/, in its own backup repository."
    exit 1
fi
